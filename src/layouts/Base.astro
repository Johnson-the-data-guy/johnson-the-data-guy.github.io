---
import { Font } from 'astro:assets';
import { SITE } from '../site';
import '../styles/global.css';

type Section = 'entries' | 'projects' | 'about';

interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string | undefined;
  description: string;
  type?: 'website' | 'article';
  published?: Date | undefined;
  tags?: string[] | undefined;
  /** Keeps the page out of search engines. Used by the 404 page. */
  noindex?: boolean | undefined;
  section?: Section | undefined;
}

const {
  title,
  description,
  type = 'website',
  published,
  tags = [],
  noindex = false,
  section,
} = Astro.props;

if (!Astro.site) throw new Error('Set `site` in astro.config.mjs');

const isHome = Astro.url.pathname === '/';
const documentTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.identity}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const nav: { href: string; label: string; section: Section }[] = [
  { href: '/', label: 'Entries', section: 'entries' },
  { href: '/projects/', label: 'Projects', section: 'projects' },
  { href: '/about/', label: 'About', section: 'about' },
];

const currentFor = (item: (typeof nav)[number]) =>
  Astro.url.pathname === item.href ? 'page' : item.section === section ? 'true' : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#EBEDE8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161B21" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.name} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-archivo" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="site-header">
        {
          isHome ? (
            <h1 class="identity">{SITE.identity}</h1>
          ) : (
            <p class="identity">
              <a href="/">{SITE.identity}</a>
            </p>
          )
        }
        <nav class="site-nav" aria-label="Site">
          <ul role="list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={currentFor(item)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <p>{SITE.name}, {new Date().getUTCFullYear()}</p>
        <p><a href={SITE.github} rel="me">GitHub</a></p>
        <p><a href="/rss.xml">RSS feed</a></p>
      </footer>
    </div>
  </body>
</html>
