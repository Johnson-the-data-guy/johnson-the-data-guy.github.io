---
import type { MarkdownLayoutProps } from 'astro';
import Base from './Base.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  description: string;
  section?: 'entries' | 'projects' | 'about';
}>;

const { title, description, section } = Astro.props.frontmatter;
---

<Base title={title} description={description} section={section}>
  <article class="article">
    <header class="article-header">
      <h1 class="article-title">{title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
