---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="There is no page at this address." noindex>
  <article class="article">
    <header class="article-header">
      <h1 class="article-title">Page not found</h1>
    </header>
    <div class="prose">
      <p>There is no page at this address. It may have been renamed or moved.</p>
      <p><a href="/">Go to the list of entries</a></p>
    </div>
  </article>
</Base>
