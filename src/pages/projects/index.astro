---
import Base from '../../layouts/Base.astro';
import { SHOW_DRAFTS, STATUS_LABELS, getProjects, projectUrl } from '../../lib/content';

const projects = await getProjects({ drafts: SHOW_DRAFTS });
---

<Base
  title="Projects"
  description="Longer pieces of work, each with its stack, repository, architecture and the logbook entries written along the way."
  section="projects"
>
  <h1 class="page-title">Projects</h1>
  {
    projects.length === 0 ? (
      <p class="empty">No projects yet.</p>
    ) : (
      <ol class="rows" role="list">
        {projects.map((project) => (
          <li class="row">
            <h2 class="row-title">
              <a href={projectUrl(project)}>{project.data.title}</a>
            </h2>
            <p class="row-text">{project.data.summary}</p>
            <p class="row-meta">
              <span>{project.data.company}</span>
              <span>{STATUS_LABELS[project.data.status]}</span>
              {project.data.draft && <span>Draft</span>}
            </p>
          </li>
        ))}
      </ol>
    )
  }
</Base>
